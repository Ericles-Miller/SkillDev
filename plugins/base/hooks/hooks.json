{
  "description": "SkillDev: guarda de comandos (npm, push protegido, commit opcional), lint a cada edição e portão de encerramento.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/guarda_comandos.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/lint_edicao.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/portao_stop.py\"",
            "timeout": 600,
            "statusMessage": "Conferindo lint e testes dos arquivos editados"
          }
        ]
      }
    ]
  }
}
